---
import { DIVULGACION } from 'directorio';
interface Props { titulo?: string; descripcion: string; articulo?: boolean; jsonld?: object }
const { titulo, descripcion, articulo = false, jsonld } = Astro.props;
const completo = titulo ? `${titulo} — Atlas Ink` : 'Atlas Ink · El mapa mundial del tatuaje';
const canonica = new URL(Astro.url.pathname, Astro.site);
const ruta = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{completo}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonica} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content={articulo ? 'article' : 'website'} />
  <meta property="og:title" content={completo} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:site_name" content="Atlas Ink" />
  <meta name="theme-color" content="#0b1f4d" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;600;800&family=Manrope:wght@400;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
  <header class="barra">
    <a href="/" class="logo"><span class="globo" aria-hidden="true"></span>ATLAS<b>INK</b></a>
    <nav>
      <a href="/" aria-current={ruta === '/' ? 'page' : undefined}>Expediciones</a>
      <a href="/paises" aria-current={ruta.startsWith('/paises') ? 'page' : undefined}>Países</a>
      <a href="/indice" aria-current={ruta.startsWith('/indice') ? 'page' : undefined}>Índice</a>
      <a href="/convenciones" aria-current={ruta.startsWith('/convenciones') ? 'page' : undefined}>Convenciones</a>
      <a href="/colofon" aria-current={ruta.startsWith('/colofon') ? 'page' : undefined}>Colofón</a>
    </nav>
  </header>
  <main><slot /></main>
  <footer>
    <div class="ancho pie">
      <a href="/" class="logo"><span class="globo" aria-hidden="true"></span>ATLAS<b>INK</b></a>
      <p>{DIVULGACION} <a href="/colofon">Colofón</a>.</p>
      <p class="mono">Salidas desde MEX · {new Date().getFullYear()}</p>
    </div>
  </footer>
</body>
</html>
<style is:global>
  :root {
    --mar: #0b1f4d; --mar2: #13306f; --mar3: #1d418f; --coral: #ff7a59; --hielo: #eef3ff; --texto: #1a2236; --suave: #5a6684; --linea: #d9e1f2;
    --titular: 'Sora', system-ui, sans-serif; --cuerpo: 'Manrope', system-ui, sans-serif; --mono: 'DM Mono', ui-monospace, monospace;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--hielo); color: var(--texto); font: 400 18px/1.7 var(--cuerpo); }
  a { color: var(--mar3); }
  h1, h2, h3 { font-family: var(--titular); line-height: 1.08; letter-spacing: -.02em; }
  .ancho { max-width: 1180px; margin: 0 auto; padding: 0 16px; }
  .mono { font: 500 12px/1.4 var(--mono); letter-spacing: .14em; text-transform: uppercase; }
  .codigo { font: 500 13px var(--mono); letter-spacing: .1em; background: var(--coral); color: var(--mar); padding: 3px 8px; border-radius: 4px; }
</style>
<style>
  .barra { position: sticky; top: 0; z-index: 20; display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; padding: 14px 24px; background: rgba(11, 31, 77, .92); backdrop-filter: blur(8px); color: #fff; border-bottom: 1px solid rgba(255,255,255,.08); }
  .logo { display: flex; align-items: center; gap: 10px; font: 800 20px var(--titular); letter-spacing: .08em; color: #fff; text-decoration: none; }
  .logo b { color: var(--coral); font-weight: 800; }
  .globo { width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--coral); background: radial-gradient(circle at 35% 35%, #3a5bb0, var(--mar) 70%); }
  nav { display: flex; gap: 6px; flex-wrap: wrap; }
  nav a { color: #c9d6fb; text-decoration: none; font: 500 13px var(--mono); text-transform: uppercase; letter-spacing: .12em; padding: 8px 12px; border-radius: 999px; }
  nav a:hover, nav a[aria-current] { background: var(--mar3); color: #fff; }
  footer { background: var(--mar); color: #c9d6fb; margin-top: 96px; padding: 48px 0; }
  .pie p { max-width: 560px; }
  .pie a:not(.logo) { color: var(--coral); }
  @media (max-width: 600px) { .barra { padding: 12px 16px; } nav { gap: 2px; } nav a { padding: 5px 7px; font-size: 11px; letter-spacing: .06em; } }
</style>
