---
import Atlas from '../../layouts/Atlas.astro';
import Mapa from '../../components/Mapa.astro';
import { getCollection } from 'astro:content';
import { artistas, estudioDe, esMagico, estilo, lugar, DIVULGACION } from 'directorio';
import { codigo } from '../../geo';
export function getStaticPaths() {
  return artistas.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props;
const estudio = estudioDe(a);
const fuentes: string[] = (a.fuentes ?? []).map((f: string | { url: string }) => (typeof f === 'string' ? f : f.url));
const host = (u: string) => { try { return new URL(u).hostname.replace('www.', ''); } catch { return u; } };
const fotos: string[] = a.imagenes?.length && a.permisoImagenes ? a.imagenes : [];
const perfil = fotos.find((f) => f.endsWith('/perfil.webp'));
const trabajos = fotos.filter((f) => f !== perfil);
const apariciones = (await getCollection('expediciones')).filter((e) => e.data.artistas.includes(a.slug));
const jsonld = { '@context': 'https://schema.org', '@type': 'Person', name: a.nombre, jobTitle: 'Artista del tatuaje', address: { '@type': 'PostalAddress', addressLocality: a.ciudad, addressCountry: a.pais }, ...(estudio && { worksFor: { '@type': 'Organization', name: estudio.nombre } }), ...(a.instagram && { sameAs: [`https://instagram.com/${a.instagram}`] }), ...(perfil && { image: perfil }) };
---
<Atlas titulo={a.nombre} descripcion={`${a.nombre}, artista del tatuaje (${lugar(a)}).`} jsonld={jsonld}>
  <section class="ancho ficha">
    <div class="pase">
      <div class="izq">
        <div class="titular">
          {perfil && <img class="perfil" src={perfil} alt={`${a.nombre}, retrato`} width="600" height="800" loading="lazy" decoding="async" />}
          <div>
        <p class="mono">Pase de artista · {a.pais || 'País por confirmar'}</p>
        <h1>{a.nombre}{esMagico(a) && ' *'}</h1>
          </div>
        </div>
        <div class="datos">
          <div><span class="mono">Base</span><strong>{codigo(a.ciudad)}</strong><small>{lugar(a)}</small></div>
          <div><span class="mono">Lenguaje</span><strong class="chico">{a.estilos.map((s: string) => estilo(s)?.nombre ?? s).join(', ')}</strong></div>
          <div><span class="mono">Estudio</span><strong class="chico">{estudio?.nombre ?? 'Independiente / por confirmar'}</strong>{a.sede && <small>Sede: {a.sede}</small>}</div>
        </div>
        {a.bio ? <p>{a.bio}</p> : <p class="pendiente">Semblanza en preparación.</p>}
        {a.instagram && <a href={`https://instagram.com/${a.instagram}`} rel="noopener">@{a.instagram} →</a>}
        {esMagico(a) && <p class="pendiente">* {DIVULGACION}</p>}
      </div>
      <div class="der"><Mapa resaltar={['Ciudad de México', a.ciudad]} /></div>
    </div>
    {trabajos.length > 0 && (
      <figure class="bitacora">
        <p class="mono">Bitácora de trabajo · {String(trabajos.length).padStart(2, '0')} piezas</p>
        <div class="placas">
          {trabajos.map((f, i) => (
            <div class="placa">
              <img src={f} alt={`Tatuaje de ${a.nombre}, trabajo ${i + 1}`} width="720" height="900" loading="lazy" decoding="async" />
              <span class="mono">Fig. {String(i + 1).padStart(2, '0')}</span>
            </div>
          ))}
        </div>
        {a.creditoImagenes && <figcaption class="mono">Crédito · {a.creditoImagenes}</figcaption>}
      </figure>
    )}
    {a.datos?.length > 0 && (
      <div class="hitos">
        <p class="mono">Hitos documentados</p>
        <ul>{a.datos.map((d: { texto: string; fuente: string }) => <li>{d.texto} <a href={d.fuente} rel="noopener" class="mono">fuente</a></li>)}</ul>
      </div>
    )}
    {apariciones.length > 0 && (
      <div class="aparece">
        <p class="mono">Aparece en</p>
        {apariciones.map((e) => <a href={`/expediciones/${e.id}`}>Exp. {String(e.data.numero).padStart(2, '0')} — {e.data.titulo}</a>)}
      </div>
    )}
    {fuentes.length > 0 && (
      <div class="hitos">
        <p class="mono">Fuentes</p>
        <ol>{fuentes.map((f) => <li><a href={f} rel="noopener">{host(f)}</a></li>)}</ol>
      </div>
    )}
    <p><a href="/indice">← Volver al índice</a></p>
  </section>
</Atlas>
<style>
  .ficha { padding-top: 48px; }
  .pase { display: grid; grid-template-columns: 1.2fr 1fr; background: #fff; border-radius: 20px; overflow: hidden; box-shadow: 0 10px 30px rgba(11,31,77,.1); }
  .izq { padding: 32px; }
  .titular .mono { color: var(--coral); margin: 0; }
  h1 { font-size: clamp(32px, 5vw, 56px); font-weight: 800; margin: 10px 0 24px; }
  .datos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; border-top: 2px dashed var(--linea); border-bottom: 2px dashed var(--linea); padding: 16px 0; margin-bottom: 20px; }
  .datos div { display: flex; flex-direction: column; }
  .datos .mono { font-size: 10px; color: var(--suave); }
  .datos strong { font: 800 32px/1.1 var(--titular); color: var(--mar); }
  .datos .chico { font-size: 16px; font-weight: 600; }
  .datos small { color: var(--suave); }
  .der { background: var(--mar); display: flex; align-items: center; padding: 12px; }
  .pendiente { color: var(--suave); font-style: italic; }
  .aparece { margin-top: 24px; display: flex; flex-direction: column; gap: 6px; }
  @media (max-width: 800px) { .pase { grid-template-columns: 1fr; } .datos { grid-template-columns: 1fr; } }
  .titular { display: flex; gap: 20px; align-items: center; }
  .titular > div { min-width: 0; }
  .perfil { flex: none; width: 112px; height: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 12px; border: 3px solid var(--mar); box-shadow: 0 0 0 3px var(--coral); }
  .bitacora { margin: 24px 0 0; background: var(--mar); color: #fff; border-radius: 16px; padding: 20px 24px; }
  .bitacora > .mono { color: var(--coral); margin: 0 0 12px; }
  .placas { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 16px; }
  .placa { position: relative; }
  .placa img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 10px; background: var(--mar2); }
  .placa .mono { position: absolute; left: 10px; bottom: 10px; font-size: 10px; background: var(--coral); color: var(--mar); padding: 3px 7px; border-radius: 4px; }
  .bitacora figcaption { margin-top: 12px; font-size: 11px; color: var(--linea); letter-spacing: .04em; }
  @media (max-width: 520px) { .izq { padding: 24px 16px; } .titular { gap: 14px; } .perfil { width: 84px; } .bitacora { padding: 16px; } }
  .hitos { margin-top: 24px; background: #fff; border-radius: 16px; padding: 20px 24px; font-size: 16px; }
  .hitos .mono { color: var(--coral); margin: 0 0 8px; }
  .hitos li { margin: 6px 0; }
  .hitos li a.mono { font-size: 10px; margin-left: 6px; }
</style>
