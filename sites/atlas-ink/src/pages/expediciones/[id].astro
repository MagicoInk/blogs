---
import Atlas from '../../layouts/Atlas.astro';
import { getCollection, render } from 'astro:content';
import { artista, esMagico, estudioDe, DIVULGACION } from 'directorio';
export async function getStaticPaths() {
  return (await getCollection('expediciones')).map((e) => ({ params: { id: e.id }, props: { e } }));
}
const { e } = Astro.props;
const { Content, headings } = await render(e);
const citados = e.data.artistas.map(artista).filter(Boolean);
const divulgar = e.data.mencionaMagico || citados.some(esMagico);
const jsonld = { '@context': 'https://schema.org', '@type': 'Article', headline: e.data.titulo, description: e.data.entradilla, datePublished: e.data.fecha.toISOString(), author: { '@type': 'Organization', name: e.data.firma }, publisher: { '@type': 'Organization', name: 'Atlas Ink', parentOrganization: { '@type': 'Organization', name: 'Magico Ink' } } };
---
<Atlas titulo={e.data.titulo} descripcion={e.data.entradilla} articulo jsonld={jsonld}>
  <article>
    <header class="columna cabeza">
      <p class="mono">Expedición {e.data.numero} · {e.data.lugar}</p>
      <h1>{e.data.titulo}</h1>
      <p class="entradilla">{e.data.entradilla}</p>
      <p class="mono">{e.data.firma} · {e.data.fecha.toLocaleDateString('es', { month: 'long', year: 'numeric' })}</p>
    </header>
    <div class="columna">
      {headings.length > 2 && (
        <nav class="ruta" aria-label="Ruta de la crónica">
          <p class="mono">La ruta</p>
          <ol>{headings.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <div class="cronica"><Content /></div>
      {citados.length > 0 && (
        <aside class="citados">
          <p class="mono">Artistas citados en esta expedición</p>
          <ul>
            {citados.map((a) => (
              <li><a href={`/artistas/${a.slug}`}>{a.nombre}</a> — {a.ciudad}, {a.pais}{estudioDe(a) && `, ${estudioDe(a).nombre}`}{esMagico(a) && <sup>*</sup>}</li>
            ))}
          </ul>
          {divulgar && <p class="aviso"><sup>*</sup> {DIVULGACION}</p>}
        </aside>
      )}
    </div>
  </article>
</Atlas>
<style>
  .cabeza { text-align: center; padding-top: 48px; }
  h1 { font-size: clamp(34px, 6vw, 56px); margin: 12px 0 18px; }
  .entradilla { font-style: italic; font-size: 22px; color: var(--suave); }
  .ruta { border: 1px solid var(--linea); padding: 12px 20px; margin: 32px 0; }
  .ruta ol { margin: 0; padding-left: 20px; font-size: 16px; }
  .cronica :global(p:first-of-type::first-letter) { float: left; font: 600 76px/0.85 var(--titular); padding: 6px 10px 0 0; color: var(--sepia); }
  .cronica :global(h2) { font-size: 30px; margin-top: 56px; text-align: center; }
  .cronica :global(h2)::before { content: '§'; display: block; color: var(--sepia); font-size: 22px; margin-bottom: 8px; }
  .cronica :global(blockquote) { margin: 36px 0; font: 300 italic 26px/1.4 var(--titular); text-align: center; border: 0; }
  .citados { margin-top: 56px; border-top: 3px double var(--tinta); padding-top: 16px; font-size: 17px; }
  .citados ul { padding-left: 18px; }
  .aviso { font-style: italic; font-size: 15px; color: var(--suave); }
</style>
