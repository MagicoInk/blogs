---
import Atlas from '../../layouts/Atlas.astro';
import Mapa from '../../components/Mapa.astro';
import { getCollection, render } from 'astro:content';
import { artista, esMagico, estudioDe, DIVULGACION } from 'directorio';
import { codigo, ciudadesGeo } from '../../geo';
export async function getStaticPaths() {
  return (await getCollection('expediciones')).map((e) => ({ params: { id: e.id }, props: { e } }));
}
const { e } = Astro.props;
const { Content, headings } = await render(e);
const citados = e.data.artistas.map(artista).filter(Boolean) as NonNullable<ReturnType<typeof artista>>[];
const destinos = [...new Set(citados.map((a) => a.ciudad))].filter((c) => ciudadesGeo[c]);
const divulgar = e.data.mencionaMagico || citados.some(esMagico);
const capitulos = headings.filter((h) => h.depth === 2);
const jsonld = { '@context': 'https://schema.org', '@type': 'Article', headline: e.data.titulo, description: e.data.entradilla, datePublished: e.data.fecha.toISOString(), author: { '@type': 'Organization', name: e.data.firma }, publisher: { '@type': 'Organization', name: 'Atlas Ink', parentOrganization: { '@type': 'Organization', name: 'Magico Ink' } } };
import { imagen, src, credito } from 'media';
---
<Atlas titulo={e.data.titulo} descripcion={e.data.entradilla} articulo jsonld={jsonld}>
  <header class="cab">
    <div class="ancho rejilla-cab">
      <div>
        <p class="mono">Expedición {String(e.data.numero).padStart(2, '0')} · {e.data.lugar}</p>
        <h1>{e.data.titulo}</h1>
        <p class="entradilla">{e.data.entradilla}</p>
        <p class="mono firma">{e.data.firma} · {e.data.fecha.toLocaleDateString('es', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
      </div>
      <div class="mini-mapa"><Mapa resaltar={['Ciudad de México', ...destinos]} /></div>
    </div>
  </header>
  <div class="ancho rejilla">
    <article class="cronica">{(() => { const p = e.data.portada && imagen(e.data.portada); return p && (
      <figure class="portada"><img src={src(p)} alt={p.descripcion || p.tituloCommons} width={p.ancho} height={p.alto} loading="eager" /><figcaption>{p.tituloCommons} — {credito(p)}. <a href={p.fuente} rel="noopener">Wikimedia Commons</a></figcaption></figure>
    ); })()}<Content />
      {e.data.fuentes.length > 0 && (
      <section class="fuentes">
        <h2>Fuentes</h2>
        <ol>{e.data.fuentes.map((f) => <li><a href={f.url} rel="noopener">{f.titulo}</a></li>)}</ol>
      </section>
    )}
    </article>
    <aside class="bitacora">
      <div class="tarjeta">
        <p class="mono titulo">Bitácora</p>
        {destinos.length > 0 && (
          <>
            <p class="mono sub">Destinos</p>
            <div class="codigos">{destinos.map((c) => <span class="codigo claro" title={c}>{codigo(c)}</span>)}</div>
          </>
        )}
        {capitulos.length > 0 && (
          <>
            <p class="mono sub">Capítulos</p>
            <ol>{capitulos.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </>
        )}
        {citados.length > 0 && (
          <>
            <p class="mono sub">Artistas citados</p>
            <ul class="citados">
              {citados.map((a) => (
                <li><a href={`/artistas/${a.slug}`}>{a.nombre}{esMagico(a) && ' *'}</a><span class="mono">{codigo(a.ciudad)} · {estudioDe(a)?.nombre ?? a.pais}</span></li>
              ))}
            </ul>
          </>
        )}
        {divulgar && <p class="aviso">* {DIVULGACION}</p>}
      </div>
    </aside>
  </div>
</Atlas>
<style>
  .cab { background: var(--mar); color: #fff; padding: 48px 0 40px; }
  .rejilla-cab { display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; align-items: center; }
  .cab .mono { color: var(--coral); }
  h1 { font-size: clamp(36px, 5.5vw, 68px); font-weight: 800; margin: 12px 0 16px; }
  .entradilla { font-size: 21px; color: #c9d6fb; margin: 0 0 16px; }
  .firma { color: #9fb3e6 !important; }
  .mini-mapa { background: var(--mar2); border-radius: 16px; padding: 8px; }
  .rejilla { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 56px; margin-top: 48px; }
  .cronica { max-width: 700px; }
  .cronica :global(h2) { font-size: 30px; margin: 48px 0 12px; display: flex; gap: 12px; align-items: baseline; }
  .cronica :global(h2)::before { content: '◆'; color: var(--coral); font-size: 16px; }
  .cronica :global(blockquote) { margin: 40px 0; padding: 28px 32px; background: var(--mar); color: #fff; border-radius: 16px; font: 300 24px/1.4 var(--titular); }
  .cronica :global(blockquote p) { margin: 0; }
  .bitacora { position: relative; }
  .tarjeta { position: sticky; top: 88px; background: #fff; border-radius: 16px; padding: 22px; box-shadow: 0 10px 30px rgba(11,31,77,.08); font-size: 15px; }
  .titulo { color: var(--mar); font-size: 14px; margin: 0 0 4px; }
  .sub { color: var(--suave); margin: 18px 0 8px; font-size: 11px; }
  .codigos { display: flex; gap: 6px; flex-wrap: wrap; }
  .codigo.claro { background: var(--hielo); color: var(--mar3); }
  ol, .citados { margin: 0; padding-left: 18px; }
  .citados { list-style: none; padding: 0; }
  .citados li { padding: 8px 0; border-bottom: 1px solid var(--linea); display: flex; flex-direction: column; }
  .citados .mono { font-size: 10px; color: var(--suave); }
  .aviso { font-size: 13px; color: var(--suave); margin: 16px 0 0; }
  @media (max-width: 900px) { .rejilla-cab, .rejilla { grid-template-columns: 1fr; } .tarjeta { position: static; } }
  .fuentes { margin-top: 56px; background: #fff; border-radius: 16px; padding: 20px 24px; font-size: 14px; }
  .fuentes h2 { font: 500 12px var(--mono) !important; letter-spacing: .14em; text-transform: uppercase; color: var(--coral); margin: 0 0 8px !important; }
  .fuentes h2::before { content: none !important; }
  .fuentes li { margin: 4px 0; word-break: break-word; }
  .portada { margin: 0 0 32px; max-width: 760px; }
  .portada img { width: 100%; height: auto; display: block; }
  .portada figcaption { font-size: 12px; opacity: .75; margin-top: 6px; line-height: 1.4; }
</style>
