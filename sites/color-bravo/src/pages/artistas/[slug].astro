---
import Bravo from '../../layouts/Bravo.astro';
import { getCollection } from 'astro:content';
import { porEstilo, lugar, etiquetasDe, etiqueta, esMagico, estudioDe, DIVULGACION } from 'directorio';
export function getStaticPaths() {
  return porEstilo('color').map((a, i) => ({ params: { slug: a.slug }, props: { a, i } }));
}
const { a, i } = Astro.props;
const color = ['var(--rojo)', 'var(--azul)', 'var(--verde)', 'var(--naranja)'][i % 4];
const estudio = estudioDe(a);
const tops = (await getCollection('top')).filter((t) => t.data.puestos.some((p) => p.artista === a.slug));
const host = (u: string) => { try { return new URL(u).hostname.replace('www.', ''); } catch { return u; } };
---
<Bravo titulo={a.nombre} descripcion={a.bio || `${a.nombre}, artista a color.`}>
  <header class="cab" style={`background:${color}`}>
    <div class="envoltura">
      <a href="/artistas/" class="volver">← ARTISTAS</a>
      <h1>{a.nombre}{esMagico(a) && ' ★'}</h1>
      <p class="tags">{etiquetasDe(a).map((e) => <span>{etiqueta(e)}</span>)}</p>
    </div>
  </header>
  <div class="envoltura rejilla">
    <section class="caja bio">
      <h2>QUIÉN ES</h2>
      <p>{a.bio || 'Ficha en preparación.'}</p>
      {a.instagram && <a class="ig caja" href={`https://instagram.com/${a.instagram}`} rel="noopener">VER SU TRABAJO EN INSTAGRAM →</a>}
    </section>
    <section class="caja datos">
      <h2>DATOS</h2>
      <dl>
        <dt>DÓNDE</dt><dd>{lugar(a)}</dd>
        <dt>ESTUDIO</dt><dd>{estudio?.nombre ?? 'Por confirmar'}</dd>
        {a.instagram && <><dt>INSTAGRAM</dt><dd><a href={`https://instagram.com/${a.instagram}`} rel="noopener">@{a.instagram}</a></dd></>}
      </dl>
    </section>
  </div>
  <div class="envoltura">
    {a.datos?.length > 0 && (
      <section class="caja hechos">
        <h2>LO QUE ESTÁ DOCUMENTADO</h2>
        <ol>{a.datos.map((d: { texto: string; fuente: string }) => <li>{d.texto} <a href={d.fuente} rel="noopener">FUENTE →</a></li>)}</ol>
      </section>
    )}
    {tops.length > 0 && (
      <section class="en-tops">
        <h2>SALE EN</h2>
        <div>{tops.map((t) => <a href={`/top/${t.id}/`} class="caja">{t.data.titulo} →</a>)}</div>
      </section>
    )}
    {a.fuentes?.length > 0 && <p class="fuentes">FUENTES: {a.fuentes.map((u: string, j: number) => <>{j > 0 && ' / '}<a href={u} rel="noopener">{host(u)}</a></>)}</p>}
    {esMagico(a) && <p class="aviso caja">★ {DIVULGACION}</p>}
  </div>
</Bravo>
<style>
  .cab { color: #fff; padding: 40px 0 48px; border-bottom: 4px solid var(--negro); }
  .volver { color: #fff; font-weight: 700; text-decoration: none; }
  h1 { font-size: clamp(56px, 11vw, 130px); margin-top: 12px; -webkit-text-stroke: 2px var(--negro); }
  .tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .tags span { background: var(--amarillo); color: var(--negro); border: 3px solid var(--negro); padding: 4px 10px; font-weight: 700; }
  .rejilla { display: grid; grid-template-columns: 2fr 1fr; gap: 28px; margin: 40px auto; }
  .rejilla section, .hechos { padding: 24px; }
  h2 { font-size: 36px; }
  .bio p { font-size: 22px; font-weight: 700; }
  dt { font: 400 18px var(--titular); margin-top: 10px; }
  dd { margin: 0; font-weight: 700; }
  .hechos li { margin: 10px 0; font-weight: 700; }
  .hechos a { font-size: 12px; }
  .en-tops { margin: 40px 0; }
  .en-tops div { display: flex; flex-wrap: wrap; gap: 16px; }
  .en-tops a { padding: 14px 18px; font-weight: 700; text-decoration: none; background: var(--amarillo); }
  .fuentes { font-size: 13px; font-weight: 700; word-break: break-word; }
  .aviso { padding: 14px; font-weight: 700; background: var(--amarillo); }
  @media (max-width: 700px) { .rejilla { grid-template-columns: 1fr; } }
  .ig { display: inline-block; padding: 12px 16px; background: var(--amarillo); font-weight: 700; text-decoration: none; margin-top: 8px; }
</style>
