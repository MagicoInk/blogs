---
import Bravo from '../../layouts/Bravo.astro';
import { porEstilo, lugar, etiquetasDe, etiqueta, esMagico, DIVULGACION } from 'directorio';
const lista = porEstilo('color').sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));
const colores = ['var(--rojo)', 'var(--azul)', 'var(--verde)', 'var(--naranja)'];
---
<Bravo titulo="Artistas a color" descripcion="Los artistas del color, el neotradicional, el tradicional, el japonés y el ilustrativo que seguimos.">
  <div class="envoltura">
    <h1 class="tit">ARTISTAS</h1>
    <p class="sub">{lista.length} fichas. Cada una con lo documentado y sus fuentes.</p>
    <div class="rejilla">
      {lista.map((a, i) => (
        <a href={`/artistas/${a.slug}/`} class="caja" style={`--c:${colores[i % 4]}`}>
          <span class="ini">{a.nombre.replace(/[^A-Za-zÁÉÍÓÚÑáéíóúñ ]/g, '').split(' ').filter(Boolean).map((p) => p[0]).slice(0, 2).join('')}</span>
          <strong>{a.nombre}{esMagico(a) && ' ★'}</strong>
          <span class="meta">{lugar(a)}</span>
          <span class="tags">{etiquetasDe(a).map(etiqueta).join(' / ')}</span>
        </a>
      ))}
    </div>
    <p class="aviso">★ {DIVULGACION}</p>
  </div>
</Bravo>
<style>
  .tit { font-size: clamp(64px, 12vw, 140px); margin-top: 40px; }
  .sub { font-size: 22px; font-weight: 700; }
  .rejilla { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 24px; margin-top: 24px; }
  .rejilla a { text-decoration: none; padding: 18px; display: flex; flex-direction: column; gap: 4px; border-top: 20px solid var(--c); }
  .rejilla a:hover { transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--negro); }
  .ini { font: 400 56px/1 var(--titular); color: var(--c); -webkit-text-stroke: 2px var(--negro); }
  strong { font: 400 28px/1 var(--titular); text-transform: uppercase; }
  .meta { font-weight: 700; font-size: 14px; }
  .tags { font-size: 12px; text-transform: uppercase; letter-spacing: .05em; }
  .aviso { font-weight: 700; margin-top: 32px; }
</style>
