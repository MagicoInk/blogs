---
import Bravo from '../../layouts/Bravo.astro';
import { estilos } from '../../estilos';
import { artistasDeEstilo } from '../../artistasEstilo';
import { lugar } from 'directorio';
export function getStaticPaths() {
  return estilos.map((e) => ({ params: { slug: e.slug }, props: { e } }));
}
const { e } = Astro.props;
const quienes = artistasDeEstilo(e.slug);
---
<Bravo titulo={e.nombre} descripcion={`${e.nombre}: ${e.frase} Rasgos, para quién es y qué revisar antes de tatuarte.`}>
  <header class="cab" style={`background:${e.color}`}>
    <div class="envoltura"><h1>{e.nombre}</h1><p>{e.frase}</p></div>
  </header>
  <div class="envoltura rejilla">
    <section class="caja"><h2>RASGOS</h2><ul>{e.rasgos.map((r) => <li>{r}</li>)}</ul></section>
    <section class="caja"><h2>ES PARA TI SI…</h2><p>{e.ideal}</p></section>
    <section class="caja ojo"><h2>OJO</h2><p>{e.ojo}</p></section>
  </div>
  {e.historia && e.historia.length > 0 && (
    <div class="envoltura">
      <section class="caja historia">
        <h2>DE DÓNDE VIENE</h2>
        {e.historia.map((p) => <p>{p}</p>)}
      </section>
    </div>
  )}
  {quienes.length > 0 && (
    <div class="envoltura">
      <h2 class="tit-art">QUIÉN LO HACE</h2>
      <div class="quienes">{quienes.map((a) => <a href={`/artistas/${a.slug}/`} class="caja"><strong>{a.nombre}</strong><span>{lugar(a)}</span></a>)}</div>
    </div>
  )}
  <div class="envoltura"><a href="/estilos/">← TODOS LOS ESTILOS</a></div>
</Bravo>
<style>
  .cab { color: #fff; padding: 56px 0; border-bottom: 4px solid var(--negro); }
  h1 { font-size: clamp(56px, 11vw, 130px); }
  .cab p { font-size: 26px; font-weight: 700; }
  .rejilla { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 28px; margin: 48px auto; }
  .rejilla section { padding: 24px; }
  h2 { font-size: 36px; }
  .ojo { background: var(--amarillo); }
  a { font-weight: 700; }
  .historia { padding: 24px; margin: 0 0 48px; border-left: 24px solid var(--negro); }
  .historia p { max-width: 760px; font-size: 19px; }
  .tit-art { font-size: 48px; margin-top: 48px; }
  .quienes { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; margin-bottom: 40px; }
  .quienes a { padding: 16px; text-decoration: none; display: flex; flex-direction: column; }
  .quienes strong { font: 400 26px/1 var(--titular); text-transform: uppercase; }
  .quienes span { font-weight: 700; font-size: 14px; }
  .quienes a:hover { background: var(--amarillo); }
</style>
