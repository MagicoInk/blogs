---
import Sala from '../layouts/Sala.astro';
const terminos: [string, string][] = [
  ['Black and grey (negro y gris)', 'Tatuaje trabajado solo con tinta negra y sus diluciones, sin color. Es el lenguaje clásico del realismo.'],
  ['Aguja sencilla (single needle)', 'Trabajo con una sola aguja o muy pocas. Es la herramienta original del negro y gris chicano y sigue siendo la base de la línea fina.'],
  ['Chicano', 'Tradición del negro y gris surgida en la cultura chicana del sur de California, con línea fina, sombreado suave, retratos, letras e imaginería religiosa y familiar.'],
  ['Realismo', 'Estilo que busca reproducir la apariencia de personas, animales u objetos mediante valores tonales, sin contornos marcados.'],
  ['Hiperrealismo', 'Realismo llevado al extremo, que imita la óptica de la fotografía: nitidez, desenfoque, reflejos y texturas muy detalladas.'],
  ['Microrrealismo', 'Realismo a escala pequeña. Exige simplificar el diseño, porque el detalle muy fino se funde con los años.'],
  ['Dilución (gray wash)', 'Tinta negra rebajada en distintas proporciones para obtener grises más claros. La consistencia entre sesiones es clave.'],
  ['Gris opaco', 'Gris con cuerpo, mezclado con blanco u otros componentes, que cubre más que una dilución transparente. Útil en fondos, metales y algunos cover-ups.'],
  ['Valor tonal', 'Qué tan claro u oscuro es un área. El realismo se construye con valores, no con líneas.'],
  ['Contraste', 'Diferencia entre los valores más claros y los más oscuros de la pieza. Sin contraste, el realismo se "lava" con los años.'],
  ['Altas luces', 'Zonas más claras de la imagen. A menudo se reservan como piel limpia o se acentúan con tinta blanca al final.'],
  ['Reserva', 'Zona de piel que se deja sin tinta, o casi, para que funcione como luz. Se decide desde el mapeo.'],
  ['Tinta blanca', 'Pigmento blanco usado para acentuar brillos. Da impacto inmediato, pero suele suavizarse con el tiempo y depende del tono de piel.'],
  ['Sombra propia', 'Sombra que tiene un objeto en el lado opuesto a la luz. Explica su volumen.'],
  ['Sombra proyectada', 'Sombra que un objeto lanza sobre otro. Puede reforzar la profundidad o confundir la lectura si cae mal.'],
  ['Borde duro', 'Transición brusca entre dos valores, como la silueta contra el fondo o el párpado contra el ojo.'],
  ['Borde perdido', 'Transición en la que dos zonas se funden sin límite visible. Alternarlo con el borde duro da aire al retrato.'],
  ['Degradado (transición)', 'Paso gradual de un valor a otro. Las mejillas y los cielos son la prueba más honesta de una buena mano.'],
  ['Bokeh (desenfoque)', 'Simulación del desenfoque de un lente fotográfico para crear planos de profundidad dentro del tatuaje.'],
  ['Textura', 'Simulación de superficies (piel, pelo, metal, tela) mediante variaciones de aguja y movimiento.'],
  ['Referencia', 'Fotografía o conjunto de imágenes en que se basa el diseño. En el realismo, marca el techo de calidad del retrato.'],
  ['Esténcil', 'Calco del diseño que se transfiere a la piel como guía antes de empezar. En realismo suele ser mínimo.'],
  ['Mapeo', 'Primera fase del tatuaje en la que el artista marca las masas principales de sombra.'],
  ['Capa', 'Cada pasada de sombreado. Los tonos profundos se construyen por capas, no de una sola vez.'],
  ['Saturación', 'Llenado completo de un área con pigmento, por ejemplo un negro sólido. Forzarla en piel ya inflamada daña el resultado.'],
  ['Magnum', 'Configuración de agujas en dos filas escalonadas que cubre un área ancha. Es la herramienta principal del sombreado.'],
  ['Magnum curvo', 'Magnum cuyas puntas forman un arco, lo que suaviza los bordes de cada pasada. Muy usado en degradados de piel.'],
  ['Round liner', 'Agujas agrupadas y apretadas en círculo. En realismo se usa para detalle fino, pelo y bordes duros.'],
  ['Máquina rotativa', 'Máquina que mueve la aguja con un motor. Incluye los modelos tipo pluma, comunes entre los realistas.'],
  ['Carrera (stroke)', 'Distancia que recorre la aguja en cada ciclo. Influye en cuánta tinta entra y en la textura.'],
  ['Sombreado en látigo (whip shading)', 'Movimiento pendular que deja más pigmento al inicio del trazo y menos al final. Ayuda a construir transiciones.'],
  ['Blowout', 'Halo borroso que aparece cuando la tinta se deposita demasiado profunda y se difunde bajo la piel.'],
  ['Cicatrizado', 'El tatuaje ya sanado. Es la única forma honesta de juzgar un realismo.'],
  ['Retoque', 'Sesión corta tras la cicatrización para reforzar negros o cerrar zonas que no tomaron igual.'],
  ['Lectura a distancia', 'Si la pieza se entiende a dos o tres metros. Un realismo que solo funciona de cerca envejecerá mal.'],
  ['Cover-up', 'Tatuaje nuevo diseñado para cubrir uno anterior. Lo oscuro cubre lo claro, nunca al revés.'],
  ['Aclarado con láser', 'Una o varias sesiones de láser para atenuar un tatuaje antes de cubrirlo, sin buscar eliminarlo por completo.'],
  ['Queloide', 'Cicatriz que crece más allá de los límites de la herida original. Ante antecedentes, se consulta a un dermatólogo antes de tatuar.'],
  ['Cicatriz hipertrófica', 'Cicatriz engrosada que se mantiene dentro de los límites de la herida original.'],
  ['Escala de Fitzpatrick', 'Clasificación dermatológica de fototipos según la reacción de la piel al sol. En el estudio se usa de forma informal para hablar de tonos de piel.'],
];
const jsonld = { '@context': 'https://schema.org', '@type': 'DefinedTermSet', name: 'Glosario de realismo en negro y gris', hasDefinedTerm: terminos.map(([name, description]) => ({ '@type': 'DefinedTerm', name, description })) };
---
<Sala titulo="Glosario" descripcion="Glosario de términos del tatuaje realista en negro y gris." jsonld={jsonld}>
  <section class="cab"><p class="mono">Referencia</p><h1>Glosario</h1></section>
  <dl>
    {terminos.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}
  </dl>
</Sala>
<style>
  .cab { padding: 48px 40px 16px; }
  h1 { font-size: clamp(44px, 8vw, 88px); margin: 8px 0; }
  dl { margin: 0; border-top: 1px solid var(--grafito); }
  dl div { display: grid; grid-template-columns: 280px 1fr; gap: 24px; padding: 20px 40px; border-bottom: 1px solid var(--grafito); }
  dt { color: var(--blanco); font-weight: 500; font-size: 20px; }
  dd { margin: 0; }
  @media (max-width: 760px) { .cab { padding: 32px 16px 12px; } dl div { grid-template-columns: 1fr; gap: 4px; padding: 16px; } }
</style>
