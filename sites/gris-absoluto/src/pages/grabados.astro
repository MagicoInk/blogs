---
import Sala from '../layouts/Sala.astro';
import { porTema, src, credito } from 'media';
const lista = porTema('irezumi', 'historia', 'marinos');
---
<Sala titulo="Grabados y fotografías antiguas" descripcion="Ukiyo-e y fotografía del siglo XIX en dominio público: la memoria visual del tatuaje.">
  <section class="cab"><p class="mono">Archivo</p><h1>Grabados</h1><p>Ukiyo-e, fotografía albúmina y documentos antiguos en dominio público. La memoria visual que el realismo hereda.</p></section>
  {lista.length === 0 ? <p class="vacio">Archivo en preparación.</p> : (
    <div class="muro">
      {lista.map((i) => (
        <figure>
          <a href={i.fuente} rel="noopener"><img src={src(i)} alt={i.descripcion || i.tituloCommons} width={i.ancho} height={i.alto} loading="lazy" /></a>
          <figcaption><strong>{i.tituloCommons}</strong><span class="mono">{credito(i)}</span></figcaption>
        </figure>
      ))}
    </div>
  )}
</Sala>
<style>
  .cab { padding: 48px 40px 24px; max-width: 800px; }
  h1 { font-size: clamp(44px, 8vw, 88px); margin: 8px 0 12px; }
  .muro { columns: 3 260px; column-gap: 2px; background: var(--grafito); border-top: 1px solid var(--grafito); }
  figure { break-inside: avoid; margin: 0 0 2px; background: var(--negro); }
  img { width: 100%; height: auto; display: block; filter: grayscale(1) contrast(1.05); transition: filter .3s; }
  figure:hover img { filter: none; }
  figcaption { padding: 12px 16px; display: flex; flex-direction: column; gap: 4px; font-size: 14px; }
  strong { color: var(--blanco); font-weight: 500; }
  .vacio { padding: 0 40px; }
  @media (max-width: 760px) { .cab, .vacio { padding-left: 16px; padding-right: 16px; } }
</style>
