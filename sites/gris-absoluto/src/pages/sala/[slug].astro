---
import Sala from '../../layouts/Sala.astro';
import { porEstilo, estudioDe, esMagico, lugar, etiquetasDe, etiqueta, DIVULGACION } from 'directorio';
export function getStaticPaths() {
  const obras = porEstilo('realismo');
  return obras.map((a, i) => ({ params: { slug: a.slug }, props: { a, ant: obras[(i - 1 + obras.length) % obras.length], sig: obras[(i + 1) % obras.length] } }));
}
const { a, ant, sig } = Astro.props;
const estudio = estudioDe(a);
const host = (u: string) => { try { return new URL(u).hostname.replace('www.', ''); } catch { return u; } };
const jsonld = { '@context': 'https://schema.org', '@type': 'Person', name: a.nombre, jobTitle: 'Artista del tatuaje realista', ...(a.ciudad && { address: { '@type': 'PostalAddress', addressLocality: a.ciudad, addressCountry: a.pais } }) };
---
<Sala titulo={`${a.nombre} · Sala de realismo`} descripcion={a.bio || `${a.nombre}, artista de realismo.`} jsonld={jsonld}>
  <article>
    <header class="cab">
      <p class="mono"><a href="/sala/">Sala</a> / ficha</p>
      <h1>{a.nombre}{esMagico(a) && ' *'}</h1>
      <p class="mono">{lugar(a, ' · ')}{estudio && ` · ${estudio.nombre}`}</p>
      <ul class="claves">{etiquetasDe(a).map((e) => <li>{etiqueta(e)}</li>)}</ul>
    </header>
    <div class="rejilla">
      <div class="obra" role="img" aria-label={`Espacio reservado para obra de ${a.nombre}`}><span class="mono">Imagen pendiente de autorización</span></div>
      <div class="texto">
        {a.bio ? <p class="bio">{a.bio}</p> : <p class="bio">Ficha en preparación.</p>}
        {a.datos?.length > 0 && (
          <>
            <h2>Registro</h2>
            <ol class="registro">{a.datos.map((d: { texto: string; fuente: string }) => <li>{d.texto} <a href={d.fuente} rel="noopener" class="mono">fuente ↗</a></li>)}</ol>
          </>
        )}
        {a.fuentes?.length > 0 && (
          <>
            <h2>Fuentes</h2>
            <ul class="fuentes">{a.fuentes.map((u: string) => <li><a href={u} rel="noopener">{host(u)}</a></li>)}</ul>
          </>
        )}
        {esMagico(a) && <p class="nota">* {DIVULGACION}</p>}
      </div>
    </div>
    <nav class="pasillo" aria-label="Recorrer la sala">
      <a href={`/sala/${ant.slug}/`}><span class="mono">← Anterior</span>{ant.nombre}</a>
      <a href={`/sala/${sig.slug}/`} class="der"><span class="mono">Siguiente →</span>{sig.nombre}</a>
    </nav>
  </article>
</Sala>
<style>
  .cab { padding: 48px 40px 24px; border-bottom: 1px solid var(--grafito); }
  .cab .mono a { color: #77777d; }
  h1 { font-size: clamp(40px, 7vw, 88px); margin: 10px 0 12px; }
  .claves { list-style: none; padding: 0; display: flex; gap: 6px; flex-wrap: wrap; }
  .claves li { font: 400 11px var(--mono); border: 1px solid #444; padding: 3px 8px; text-transform: uppercase; }
  .rejilla { display: grid; grid-template-columns: 1fr 1.2fr; border-bottom: 1px solid var(--grafito); }
  .obra { min-height: 420px; background: radial-gradient(circle at 40% 35%, #6d6d73 0%, #2a2a2e 45%, var(--negro) 100%); display: flex; align-items: flex-end; padding: 16px; border-right: 1px solid var(--grafito); }
  .texto { padding: 32px 40px; }
  .bio { font-size: 21px; color: var(--blanco); }
  h2 { font-size: 26px; margin-top: 32px; }
  .registro li { margin: 10px 0; }
  .registro a, .fuentes a { color: var(--plata); }
  .fuentes { font-size: 14px; }
  .nota { font-size: 14px; margin-top: 24px; }
  .pasillo { display: grid; grid-template-columns: 1fr 1fr; }
  .pasillo a { padding: 24px 40px; text-decoration: none; display: flex; flex-direction: column; font-size: 22px; border-right: 1px solid var(--grafito); }
  .pasillo a:hover { background: var(--carbon); }
  .pasillo .der { text-align: right; border-right: 0; }
  @media (max-width: 760px) {
    .cab, .texto { padding-left: 16px; padding-right: 16px; }
    .rejilla { grid-template-columns: 1fr; }
    .obra { min-height: 220px; border-right: 0; }
    .pasillo a { padding: 18px 16px; font-size: 17px; }
  }
</style>
