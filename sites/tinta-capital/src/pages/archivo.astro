---
import Base from '../layouts/Base.astro';
import { porTema, src, credito } from 'media';
const lista = porTema('historia', 'occidente', 'mexico', 'marinos', 'maquinas', 'herramientas');
---
<Base titulo="Archivo: el tatuaje en imágenes antiguas" descripcion="Imágenes históricas de dominio público sobre la historia del tatuaje, con su crédito y fuente.">
  <div class="contenedor cuerpo">
    <span class="etiqueta">Archivo</span>
    <h1>El tatuaje en imágenes antiguas</h1>
    <p class="intro">Grabados, fotos y documentos históricos en dominio público. Cada imagen lleva su autor, fecha y enlace a Wikimedia Commons.</p>
    {lista.length === 0 ? <p>Archivo en preparación.</p> : (
      <div class="muro">
        {lista.map((i) => (
          <figure>
            <a href={i.fuente} rel="noopener"><img src={src(i)} alt={i.descripcion || i.tituloCommons} width={i.ancho} height={i.alto} loading="lazy" /></a>
            <figcaption><strong>{i.tituloCommons}</strong><span>{credito(i)}</span></figcaption>
          </figure>
        ))}
      </div>
    )}
  </div>
</Base>
<style>
  .cuerpo { padding-top: 40px; }
  h1 { font-size: clamp(2.2rem, 6vw, 4rem); margin-top: 12px; }
  .intro { max-width: 680px; font-size: 1.15rem; }
  .muro { columns: 3 280px; column-gap: 20px; margin-top: 24px; }
  figure { break-inside: avoid; margin: 0 0 20px; border: 3px solid var(--negro); background: #fff; }
  img { width: 100%; height: auto; display: block; border-bottom: 3px solid var(--negro); }
  figcaption { padding: 10px 12px; font-size: 13px; display: flex; flex-direction: column; gap: 2px; }
  figcaption span { color: var(--sutil); }
</style>
