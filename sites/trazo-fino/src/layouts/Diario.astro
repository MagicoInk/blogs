---
import { DIVULGACION } from 'directorio';
interface Props { titulo?: string; descripcion: string; jsonld?: object }
const { titulo, descripcion, jsonld } = Astro.props;
const completo = titulo ? `${titulo} — trazo fino` : 'trazo fino — un diario sobre líneas pequeñas';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{completo}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content={completo} />
  <meta property="og:description" content={descripcion} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400&display=swap" rel="stylesheet" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
  <header>
    <a href="/" class="firma">trazo <i>fino</i></a>
    <nav><a href="/">notas</a><a href="/artistas/">lista corta</a><a href="/preguntas/">preguntas</a><a href="/sobre/">sobre</a></nav>
  </header>
  <main><slot /></main>
  <footer>
    <svg viewBox="0 0 200 20" aria-hidden="true"><path d="M0 10 C 40 0, 60 20, 100 10 S 160 0, 200 10" fill="none" stroke="currentColor" stroke-width=".6" /></svg>
    <p>{DIVULGACION}</p>
  </footer>
</body>
</html>
<style is:global>
  :root { --hueso: #fbf7f4; --rubor: #f6ede8; --salvia: #dfe7df; --grafito: #3b3b3b; --tenue: #8b8580; --serif: 'Cormorant Garamond', Georgia, serif; --sans: 'DM Sans', system-ui, sans-serif; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--hueso); color: var(--grafito); font: 300 17px/1.85 var(--sans); }
  main { max-width: 600px; margin: 0 auto; padding: 0 16px; }
  a { color: var(--grafito); text-decoration-thickness: .5px; text-underline-offset: 4px; }
  h1, h2 { font-family: var(--serif); font-weight: 400; line-height: 1.15; }
  h1 { font-size: clamp(34px, 6vw, 46px); }
  .tenue { color: var(--tenue); font-size: 14px; letter-spacing: .02em; }
  .tema { display: inline-block; background: var(--salvia); border-radius: 99px; padding: 1px 10px; font-size: 12px; margin-right: 4px; }
</style>
<style>
  header { max-width: 600px; margin: 0 auto; padding: 48px 16px 56px; display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 12px; }
  .firma { font: 400 28px var(--serif); text-decoration: none; }
  nav { display: flex; gap: 18px; font-size: 14px; }
  nav a { text-decoration: none; color: var(--tenue); }
  nav a:hover { color: var(--grafito); }
  footer { max-width: 600px; margin: 96px auto 0; padding: 0 16px 56px; text-align: center; color: var(--tenue); font-size: 14px; }
  footer svg { width: 160px; color: var(--tenue); }
</style>
