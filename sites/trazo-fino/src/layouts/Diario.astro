---
import { DIVULGACION } from 'directorio';
interface Props { titulo?: string; descripcion: string; jsonld?: object }
const { titulo, descripcion, jsonld } = Astro.props;
const completo = titulo ? `${titulo} · trazo fino` : 'trazo fino · cuaderno de línea fina y microrrealismo';
const ruta = Astro.url.pathname;
const links = [['/', 'cuaderno'], ['/artistas/', 'lista corta'], ['/laminas/', 'láminas'], ['/preguntas/', 'preguntas'], ['/sobre/', 'sobre']];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{completo}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content={completo} />
  <meta property="og:description" content={descripcion} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@200;300;500&family=Caveat:wght@500&display=swap" rel="stylesheet" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
  <header>
    <a href="/" class="firma">trazo<span>/</span>fino</a>
    <nav>{links.map(([h, t]) => <a href={h} aria-current={ruta === h ? 'page' : undefined}>{t}</a>)}</nav>
  </header>
  <main><slot /></main>
  <footer>
    <span class="mano">— hecho a pulso</span>
    <p>{DIVULGACION}</p>
  </footer>
</body>
</html>
<style is:global>
  :root { --papel: #ffffff; --cuadro: #edf0f5; --tinta: #1c1c1e; --tenue: #8a8f98; --lapiz: #e2483d; --sans: 'Outfit', system-ui, sans-serif; --mano: 'Caveat', cursive; }
  * { box-sizing: border-box; }
  body { margin: 0; color: var(--tinta); font: 300 17px/1.75 var(--sans); background-color: var(--papel);
    background-image: linear-gradient(var(--cuadro) 1px, transparent 1px), linear-gradient(90deg, var(--cuadro) 1px, transparent 1px);
    background-size: 24px 24px; }
  a { color: var(--tinta); text-decoration-color: var(--lapiz); text-decoration-thickness: 1px; text-underline-offset: 4px; }
  h1, h2, h3 { font-weight: 200; letter-spacing: -.02em; line-height: 1.05; }
  .mano { font-family: var(--mano); color: var(--lapiz); font-size: 22px; line-height: 1; }
  .hoja { max-width: 1200px; margin: 0 auto; padding: 0 16px; }
</style>
<style>
  header { max-width: 1200px; margin: 0 auto; padding: 28px 16px; display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .firma { font: 200 30px var(--sans); text-decoration: none; letter-spacing: -.02em; }
  .firma span { color: var(--lapiz); margin: 0 2px; }
  nav { display: flex; gap: 4px; flex-wrap: wrap; }
  nav a { text-decoration: none; font-size: 15px; padding: 4px 12px; border: 1px solid transparent; border-radius: 999px; background: rgba(255,255,255,.8); }
  nav a:hover { border-color: var(--tinta); }
  nav a[aria-current] { border-color: var(--tinta); background: var(--tinta); color: #fff; }
  footer { max-width: 1200px; margin: 96px auto 0; padding: 24px 16px 48px; border-top: 1px solid var(--tinta); display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; color: var(--tenue); font-size: 14px; }
  footer p { margin: 0; max-width: 560px; }
</style>
