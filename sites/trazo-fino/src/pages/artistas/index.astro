---
import Diario from '../../layouts/Diario.astro';
import { porEstilo, estudioDe, esMagico, lugar, DIVULGACION } from 'directorio';
const lista = porEstilo('fine-line');
---
<Diario titulo="lista corta" descripcion="Artistas de línea fina y microrrealismo que seguimos de cerca, en México y el mundo.">
  <section class="hoja">
    <span class="mano">sin orden de importancia</span>
    <h1>lista corta</h1>
    <div class="tabla">
      <div class="fila cab"><span>#</span><span>artista</span><span>lugar</span><span>estudio</span></div>
      {lista.map((a, i) => (
        <div class="fila">
          <span class="mano">{String(i + 1).padStart(2, '0')}</span>
          <span class="nombre"><a href={`/artistas/${a.slug}/`}>{a.nombre}</a>{esMagico(a) && <sup>✦</sup>}{a.instagram && <a href={`https://instagram.com/${a.instagram}`} rel="noopener"> @{a.instagram}</a>}</span>
          <span>{lugar(a)}</span>
          <span class="tenue">{estudioDe(a)?.nombre ?? '—'}</span>
        </div>
      ))}
    </div>
    <p class="aviso">✦ {DIVULGACION}</p>
  </section>
</Diario>
<style>
  h1 { font-size: clamp(56px, 10vw, 120px); margin: 0 0 32px; }
  .tabla { background: #fff; border: 1px solid var(--tinta); }
  .fila { display: grid; grid-template-columns: 60px 1.4fr 1fr 1fr; gap: 16px; padding: 14px 20px; border-bottom: 1px solid var(--cuadro); align-items: baseline; }
  .fila:last-child { border-bottom: 0; }
  .cab { font-size: 12px; text-transform: uppercase; letter-spacing: .14em; color: var(--tenue); border-bottom: 1px solid var(--tinta); }
  .nombre { font-weight: 500; }
  .tenue { color: var(--tenue); }
  .aviso { font-size: 14px; color: var(--tenue); }
  @media (max-width: 700px) { .fila { grid-template-columns: 40px 1fr; } .fila > :nth-child(n+3) { grid-column: 2; } .cab { display: none; } }
</style>
